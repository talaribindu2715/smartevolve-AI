{
  "expo": {
    "name": "SmartEvolve AI",
    "slug": "smartevolve-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "smartevolve",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F19"
      },
      "package": "com.smartevolve.ai"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "updates": {
      "url": "https://u.expo.dev/a78e111a-884d-4fc0-9317-782456e20aa4"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "extraGradleProperties": {
              "suppressKotlinVersionCompatibilityCheck": "true",
              "android.kotlinVersion": "1.9.25"
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a78e111a-884d-4fc0-9317-782456e20aa4"
      }
    }
  }
}
