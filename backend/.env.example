# SmartEvolve AI Backend Environment Variables
PORT=8080

# Supabase PostgreSQL Database (Transaction or Session pooler URL)
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_SUPABASE_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Supabase Auth Configuration
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET_OR_HMAC_KEY
SUPABASE_JWT_ISSUER=https://YOUR_SUPABASE_PROJECT_REF.supabase.co/auth/v1

# EVM Blockchain Integration
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
